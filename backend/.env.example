DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_data_analyst
ENV=dev
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173

# Local SMTP: Mailpit normally uses port 1025 without TLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AI Data Analyst <no-reply@localhost>
SMTP_TLS=false

# Groq API — obtenez votre clé gratuite sur https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
