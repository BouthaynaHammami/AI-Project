DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_data_analyst
ENV=dev
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# Access tokens are capped at 30 minutes; email codes expire in 10 minutes.
JWT_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173

# Monthly analysis quota applied to new accounts.
DEFAULT_MONTHLY_QUOTA=50
# Promote this existing account to admin during startup; never set via signup.
INITIAL_ADMIN_EMAIL=
# Analysis requests per authenticated user and total Groq requests per minute.
ANALYSIS_USER_RPM=5
GROQ_GLOBAL_RPM=20

# Codes can be resent no more than once every 60 seconds.
# Local SMTP: Mailpit normally uses port 1025 without TLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AI Data Analyst <no-reply@localhost>
SMTP_TLS=false

# Groq API — obtenez votre clé gratuite sur https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
